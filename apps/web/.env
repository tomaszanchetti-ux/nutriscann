# Identidad del proyecto Firebase.
#
# Estos valores son PÚBLICOS por diseño: identifican al proyecto, no autorizan
# nada. La seguridad la dan las reglas de Firestore/Storage y App Check (Fase 4),
# no el secreto de estas claves. Por eso están versionados.
#
# Lo que sí es secreto — la API key de Anthropic — vive en Secret Manager y
# nunca llega al navegador.
VITE_FB_API_KEY=AIzaSyDDXKZLifmKuSa7FZNuDj5wzU6st4p2g1k

# ⚠️ EL DOMINIO DEL LOGIN ES EL NUESTRO, NO EL DE FIREBASE (card 4.1).
#
# Era `nutriscann-f809e.firebaseapp.com` y pasó a `app.caliscan.app`, que es
# desde donde se sirve la PWA. El motivo es caro y no se ve hasta que rompe: al
# entrar, Firebase pasa por `https://<authDomain>/__/auth/handler` y ahí deja una
# cookie. Si ese dominio NO es el mismo desde el que se abrió la app, para Safari
# y para la PWA instalada en un iPhone esa cookie es DE TERCEROS —el
# particionado de cookies la aísla— y el login por redirección se queda dando
# vueltas sin entrar nunca. Con el dominio propio la cookie es de primera parte y
# el circuito cierra.
#
# Verificado antes de este cambio: `https://app.caliscan.app/__/auth/handler`
# responde 200 y el dominio está autorizado en Firebase Auth. Si alguna vez se
# sirve la app desde otro sitio, esto cambia con ella.
VITE_FB_AUTH_DOMAIN=app.caliscan.app
VITE_FB_PROJECT_ID=nutriscann-f809e
VITE_FB_STORAGE_BUCKET=nutriscann-f809e.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=590554450084
VITE_FB_APP_ID=1:590554450084:web:420bce4c2546ab893e7e31

# Región donde viven las Cloud Functions.
VITE_FUNCTIONS_REGION=europe-west1

# ── App Check: la prueba de que el pedido sale de la app (card 4.4) ──────────
#
# En 1, la PWA le pide a reCAPTCHA Enterprise una prueba de que es un navegador
# de verdad y la manda al backend en la cabecera `X-Firebase-AppCheck`. Es lo que
# distingue nuestra app de un script con una cuenta gratis, y lo que evita que
# nuestra API key de Anthropic pague fotos que nadie va a mirar.
#
# ACÁ VA EN 1 PORQUE ESTE ARCHIVO ES EL DE PRODUCCIÓN. En la máquina de uno se
# apaga escribiendo `VITE_APP_CHECK=0` en `apps/web/.env.local`, que Vite
# prioriza sobre este archivo — ver `.env.local.example`, que explica qué
# implica.
VITE_APP_CHECK=1

# La clave de reCAPTCHA Enterprise (tipo SCORE), acotada a caliscan.app,
# app.caliscan.app, nutriscann-f809e.web.app y localhost.
#
# ES PÚBLICA, igual que las de arriba: va escrita en el HTML de cualquier sitio
# que use reCAPTCHA y no autoriza nada por sí sola. Lo que la protege es la lista
# de dominios, no el secreto. Que también valga para `localhost` es deliberado:
# permite ensayar App Check encendido desde la máquina de uno, sin necesidad de
# los "debug tokens" de Firebase (el porqué está en `src/lib/appcheck.ts`).
VITE_APP_CHECK_SITE_KEY=6LfCz6QtAAAAAKVpbwFh7DEOqEsB2qlWIPsV5cpL
